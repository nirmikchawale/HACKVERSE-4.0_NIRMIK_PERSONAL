{
  "name": "agri-foresight",
  "main": "worker.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./frontend/dist",
    "run_worker_first": [
      "/api/*",
      "/openapi.json"
    ],
    "not_found_handling": "single-page-application"
  }
}
