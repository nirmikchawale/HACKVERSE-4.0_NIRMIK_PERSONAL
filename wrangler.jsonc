{
  "name": "agri-foresight",
  "main": "backend/worker.py",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./frontend/dist",
    "run_worker_first": [
      "/api/*",
      "/openapi.json"
    ],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
